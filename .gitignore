# Test audio files (large, don't commit)
/tests/**/*.m4a

# Output subfiles from batch processing
/tests/**/*_subfile/

# Second brain exports
/second_brain_export/

# Python
__pycache__/
*.pyc
*.pyo

# Logs
logs/

# OS
.DS_Store

# Test complete outputs and versioned re-runs
/tests/test_complete/
/tests/**/*_subfile[*/

# Impeccable config (local tooling)
.impeccable/

# Voice-dynamics calibration audio (real acted-emotion clips sourced from
# public-domain films for threshold tuning) and their transcription outputs
# -- never commit raw audio, even if this folder ends up nested in the repo.
/calibration_audio/
**/calibration_audio/

# Round 2 calibration audio (real testimony/argument recordings sourced
# from public inquiries, archive.org, and courts.gov for threshold/agreement
# validation) -- never commit raw audio here either.
/calibration_audio_r2/
**/calibration_audio_r2/

# Keep folder structure
!tests/**/.gitkeep
